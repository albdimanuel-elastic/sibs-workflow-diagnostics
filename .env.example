# Copy this file to .env and fill in your own values.
# .env is gitignored. Do not commit API keys, host addresses, or SSH keys.

# Kibana and Elasticsearch for the Security project.
KIBANA_URL=https://your-deployment.kb.example.com
ELASTICSEARCH_URL=https://your-deployment.es.example.com
ELASTICSEARCH_API_KEY=

# SSH target for scripts/remote-*.sh and scripts/agent-shell.sh
AGENT_HOST=
AGENT_USER=ubuntu
# AGENT_SSH_PORT=22
# Private key that can log in as AGENT_USER. Keep the key outside git.
AGENT_SSH_KEY=
